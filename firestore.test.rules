rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary test-only fallback while Firebase UID ownership is not yet mapped
    // to ChatPHT local accounts. Never publish this rule to production.
    match /p2p_calls/{callId} { allow read, write: if true; }
    match /p2p_calls/{callId}/{document=**} { allow read, write: if true; }
    match /p2p_signals/{docId} { allow read, write: if true; }
  }
}
