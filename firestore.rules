rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /p2p_calls/{callId} {
      // TEST MODE ONLY: removes Firestore permission-denied while P2P is validated.
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }
    match /p2p_signals/{docId} {
      allow read, write: if true;
    }
  }
}
